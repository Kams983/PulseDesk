# The deployed api origin, no trailing slash and no /api path: the client appends the versioned path.
# The build reads this, so it must be set before `vite build`, e.g. from the repository variable
# VITE_API_URL in the Pages workflow. Locally it stays unset and the requests go through the Vite proxy.
VITE_API_URL=https://pulsedesk-api.kamy.name.ng
