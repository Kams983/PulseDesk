# The client talks to the API through the Vite dev proxy, so the refresh cookie stays first party.
# Point this at the API when it is not on the default port, or at a deployed API during development.
VITE_API_TARGET=http://localhost:5000

# Leave VITE_API_URL unset in development: calls stay relative and the proxy forwards them.
# The production build sets it to the deployed api; see .env.production.example.
