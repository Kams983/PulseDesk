NODE_ENV=development
PORT=5000
# Local mongod. In production this is the Atlas connection string, for example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulsedesk?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/emr
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-32-chars-min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Local client. In production this is the deployed client origin, https://pulsedesk.kamy.name.ng:
# it is the one origin CORS and the socket allow, and it is where the refresh cookie is Secure.
CLIENT_ORIGIN=http://localhost:5173
CLINIC_TIMEZONE=Africa/Lagos
