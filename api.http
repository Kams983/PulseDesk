# EMR api requests
# Run the api with `npm run dev` inside server/ (on this machine: `env -u PORT npm run dev`, the shell exports PORT=0)
# Seed the demo data first with `npm run seed`.
# In VS Code press "Send Request" above a block. For a terminal, the curl equivalent is in the comment.

@host = http://localhost:5000/api/v1
# password for every demo account
@password = Password123!

### Health, should be 200
# curl -i http://localhost:5000/api/v1/health
GET {{host}}/health

### Sign in as super_admin, stores the cookie set by the response
# curl -i -c cookies.txt -H "Content-Type: application/json" -d '{"email":"admin@emr.test","password":"Password123!"}' http://localhost:5000/api/v1/auth/login
# @name adminLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@emr.test",
  "password": "{{password}}"
}

### Sign in as doctor
# @name doctorLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "dr.okafor@emr.test",
  "password": "{{password}}"
}

### Sign in as receptionist
# @name receptionLogin
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "reception@emr.test",
  "password": "{{password}}"
}

### Wrong password, must be a generic 401 and write a LOGIN_FAILED audit row
# curl -i -H "Content-Type: application/json" -d '{"email":"admin@emr.test","password":"WrongPassword1!"}' http://localhost:5000/api/v1/auth/login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@emr.test",
  "password": "WrongPassword1!"
}

### Unknown email, must be the same generic 401 as above
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "nobody@emr.test",
  "password": "{{password}}"
}

### Fails validation, 400 with the field in the details
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short"
}

### Who am I, paste the accessToken from a login response
# curl -i -H "Authorization: Bearer $ACCESS_TOKEN" http://localhost:5000/api/v1/auth/me
GET {{host}}/auth/me
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}

### No token, must be 401
GET {{host}}/auth/me

### Refresh, the browser sends the httpOnly cookie automatically
# curl -i -b cookies.txt -c cookies.txt -X POST http://localhost:5000/api/v1/auth/refresh
POST {{host}}/auth/refresh

### Reusing an old refresh token after a refresh, must be 401
POST {{host}}/auth/refresh

### Sign out, must be 200 even when the cookie is already gone
# curl -i -b cookies.txt -X POST http://localhost:5000/api/v1/auth/logout
POST {{host}}/auth/logout

### RBAC was proven here with a temporary GET /admin-check route (doctor 403, admin 200), which has
### been removed again. The next phase adds real role guarded routes and the checks move to those.

### Departments, any signed in role
# curl -H "Authorization: Bearer $ACCESS_TOKEN" http://localhost:5000/api/v1/departments
GET {{host}}/departments
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}

### Doctors, with the optional filters
# curl -H "Authorization: Bearer $ACCESS_TOKEN" "http://localhost:5000/api/v1/doctors?q=okafor"
GET {{host}}/doctors?q=okafor
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}

### One doctor
GET {{host}}/doctors/PASTE_A_DOCTOR_ID
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}

### A doctor reading another doctor, expect 403
GET {{host}}/doctors/PASTE_ANOTHER_DOCTOR_ID
Authorization: Bearer {{doctorLogin.response.body.data.accessToken}}

### Create a doctor, super_admin only. 409 when the email already exists
# curl -X POST -H "Authorization: Bearer $ADMIN_TOKEN" -H "Content-Type: application/json" -d @doctor.json http://localhost:5000/api/v1/doctors
POST {{host}}/doctors
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "name": "Dr. Halima Sani",
  "email": "dr.sani@emr.test",
  "password": "Password123!",
  "departmentId": "PASTE_A_DEPARTMENT_ID",
  "specialization": "Physician",
  "slotDurationMinutes": 20,
  "schedule": [
    {
      "dayOfWeek": 1,
      "sessions": [
        { "name": "Morning", "start": "09:00", "end": "12:00" },
        { "name": "Evening", "start": "13:00", "end": "17:00" }
      ],
      "breaks": [{ "name": "Lunch", "start": "12:00", "end": "13:00" }]
    }
  ]
}

### Replace a schedule, super_admin only. Every rule failure comes back as a field in meta.details
# curl -X PUT -H "Authorization: Bearer $ADMIN_TOKEN" -H "Content-Type: application/json" -d @schedule.json http://localhost:5000/api/v1/doctors/$DOCTOR_ID/schedule
PUT {{host}}/doctors/PASTE_A_DOCTOR_ID/schedule
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "slotDurationMinutes": 15,
  "schedule": [
    {
      "dayOfWeek": 2,
      "sessions": [{ "start": "10:00", "end": "11:00" }],
      "breaks": [{ "start": "10:30", "end": "10:45" }]
    }
  ]
}

### Availability for a doctor and a date
# curl -H "Authorization: Bearer $ACCESS_TOKEN" "http://localhost:5000/api/v1/slots?doctorId=$DOCTOR_ID&date=2026-10-16"
GET {{host}}/slots?doctorId=PASTE_A_DOCTOR_ID&date=2026-10-16
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}

### A receptionist creating a doctor, expect 403
POST {{host}}/doctors
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "name": "Dr. Nope",
  "email": "dr.nope@emr.test",
  "password": "Password123!",
  "departmentId": "PASTE_A_DEPARTMENT_ID"
}

### Create a receptionist, super_admin only
POST {{host}}/users/receptionists
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "name": "Ada Okeke",
  "email": "ada@emr.test",
  "password": "Password123!"
}

### An invalid schedule, expect 400 with schedule.0.sessions.0.start named
PUT {{host}}/doctors/PASTE_A_DOCTOR_ID/schedule
Authorization: Bearer {{adminLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "slotDurationMinutes": 20,
  "schedule": [{ "dayOfWeek": 1, "sessions": [{ "start": "9am", "end": "10:00" }] }]
}

### Patients, one box for a code, a mobile number or a name
# curl -H "Authorization: Bearer $ACCESS_TOKEN" "http://localhost:5000/api/v1/patients?q=Chiamaka"
GET {{host}}/patients?q=Chiamaka
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### The same box by code, and by mobile
GET {{host}}/patients?q=PT-000001
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

GET {{host}}/patients?q=0803
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### One patient. A doctor is refused unless they have seen them
GET {{host}}/patients/PASTE_A_PATIENT_ID
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### Book a slot for a new patient, the desk only knows a name and a mobile
# curl -X POST -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -d @booking.json http://localhost:5000/api/v1/appointments
POST {{host}}/appointments
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "doctorId": "PASTE_A_DOCTOR_ID",
  "date": "2026-10-16",
  "startTime": "10:00",
  "newPatient": { "name": "Uche Obi", "mobile": "08040001111", "gender": "male" },
  "purpose": "Fever"
}

### Book for an existing patient
POST {{host}}/appointments
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "doctorId": "PASTE_A_DOCTOR_ID",
  "date": "2026-10-16",
  "startTime": "10:15",
  "patientId": "PASTE_A_PATIENT_ID"
}

### A time the grid does not offer, expect 400 with startTime named
POST {{host}}/appointments
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "doctorId": "PASTE_A_DOCTOR_ID",
  "date": "2026-10-16",
  "startTime": "09:07",
  "patientId": "PASTE_A_PATIENT_ID"
}

### A slot someone already holds, expect 409
POST {{host}}/appointments
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "doctorId": "PASTE_A_DOCTOR_ID",
  "date": "2026-10-16",
  "startTime": "10:00",
  "patientId": "PASTE_A_PATIENT_ID"
}

### The day's list with every filter
# curl -H "Authorization: Bearer $TOKEN" "http://localhost:5000/api/v1/appointments?dateFrom=2026-10-16&dateTo=2026-10-16&status=scheduled&sortBy=startTime&sortOrder=asc&page=1&limit=10"
GET {{host}}/appointments?dateFrom=2026-10-16&dateTo=2026-10-16&sortBy=startTime&sortOrder=asc&page=1&limit=10
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### Search the list by patient name, mobile or doctor name
GET {{host}}/appointments?q=Chiamaka
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

GET {{host}}/appointments?doctor=dr.%20okafor&dateFrom=2026-10-16&dateTo=2026-10-16
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### A doctor asking for another doctor's list still only sees their own
GET {{host}}/appointments?doctorId=PASTE_ANOTHER_DOCTOR_ID
Authorization: Bearer {{doctorLogin.response.body.data.accessToken}}

### One appointment
GET {{host}}/appointments/PASTE_AN_APPOINTMENT_ID
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### Edit the purpose and notes
PUT {{host}}/appointments/PASTE_AN_APPOINTMENT_ID
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "purpose": "Fever and rash",
  "notes": "Sent for a blood test"
}

### The desk marks the patient arrived
POST {{host}}/appointments/PASTE_AN_APPOINTMENT_ID/arrive
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### Arriving a visit dated after today, expect 409 because the status and the date would contradict
POST {{host}}/appointments/PASTE_A_FUTURE_APPOINTMENT_ID/arrive
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### The doctor closes the visit
POST {{host}}/appointments/PASTE_AN_APPOINTMENT_ID/complete
Authorization: Bearer {{doctorLogin.response.body.data.accessToken}}

### Completing as a receptionist, expect 403: closing a visit is the doctor's act, not the desk's
POST {{host}}/appointments/PASTE_AN_ARRIVED_APPOINTMENT_ID/complete
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### Cancel with a reason, expect 409 if it is already completed
# curl -X DELETE -H "Authorization: Bearer $TOKEN" -H "Content-Type: application/json" -d '{"reason":"Patient called"}' http://localhost:5000/api/v1/appointments/$ID
DELETE {{host}}/appointments/PASTE_AN_APPOINTMENT_ID
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}
Content-Type: application/json

{
  "reason": "Patient called to cancel"
}

### The dashboard, which changes shape with the role
# The first key is `today`, the clinic's calendar date, which is the clock the client uses instead of
# the browser's. Counts live under `counts.today` (and `counts.upcoming` for a doctor).
# curl -H "Authorization: Bearer $TOKEN" http://localhost:5000/api/v1/dashboard
GET {{host}}/dashboard
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

GET {{host}}/dashboard
Authorization: Bearer {{doctorLogin.response.body.data.accessToken}}

### The seven day trend behind the chart, one entry per day ending today, zero filled
# curl -H "Authorization: Bearer $TOKEN" "http://localhost:5000/api/v1/dashboard/trend?days=7"
GET {{host}}/dashboard/trend
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### The same series for a doctor, which only counts their own appointments
GET {{host}}/dashboard/trend?days=14
Authorization: Bearer {{doctorLogin.response.body.data.accessToken}}

### A window outside 1 to 31 days is a 400 naming the field
GET {{host}}/dashboard/trend?days=99
Authorization: Bearer {{receptionLogin.response.body.data.accessToken}}

### The 404 shape for an unknown route
GET {{host}}/nope

### Realtime: there is no request to send here, a socket carries it
# The socket.io server listens on the same host and port. Connect with the access token:
#   const socket = io("http://localhost:5000", { auth: { token: accessToken } });
#   socket.emit("scheduler:join", { doctorId, date }, (ack) => console.log(ack));
#   socket.emit("scheduler:leave", { doctorId, date }, (ack) => console.log(ack));
# Then listen for appointment:created, appointment:updated and appointment:cancelled, each carrying
# { id, doctorId, date, startTime, status } only. Refetch the row with the api above when one arrives.
# A connection without a valid token is refused, and a doctor can only join their own board.
